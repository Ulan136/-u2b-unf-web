# Neon PostgreSQL (Dashboard → Connection string → pooled)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Секрет для вебхуков от Юкан (заголовок X-Ukan-Secret)
UKAN_WEBHOOK_SECRET=change-me-long-random

# URL Юкан (для исходящих вызовов, позже)
UKAN_API_URL=
UKAN_API_KEY=
